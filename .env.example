# Docker image. Pin a release tag in production; do not use latest on a robot.
RYSEN_RETARGETING_IMAGE=ghcr.io/rysenrobotics/rysen-retargeting:0.2.1-amd64

# Must match rysen_apexhand, WebGUI backend, and other ROS 2 containers.
ROS_DOMAIN_ID=111
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# GUI calibration only. Leave empty when the host has no desktop/X11 session.
# DISPLAY=:0
MUJOCO_GL=glfw
