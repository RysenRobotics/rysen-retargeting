# Docker image published by the private build pipeline.
# Pin a release tag in production; do not use latest for deployed robots.
RYSEN_RETARGETING_IMAGE=ghcr.io/rysenrobotics/rysen-retargeting:0.1.0-amd64

# Must match rysen_apexhand, WebGUI backend, and other ROS 2 containers.
ROS_DOMAIN_ID=111
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Persistent MANUS pose-calibration YAML, relative to the mounted calibration dir.
MANUS_RUNTIME_CALIBRATION_FILE=/data/calibration/manus_runtime_calibration.yaml

# Optional MuJoCo viewer. Requires a local X11 display and xhost permission.
ENABLE_VIEWER=false
DISPLAY=:0
MANUS_UDEV=1
